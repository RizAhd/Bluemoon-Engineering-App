    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-task-manager": "~58.0.12",
    "expo-web-browser": "~58.0.6",
    "jszip": "^3.10.2",
    "lucide-react-native": "^1.61.0",
    "pdf-lib": "^1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
