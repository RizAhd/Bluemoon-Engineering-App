{
  "expo": {
    "name": "Bluemoon Site",
    "slug": "bluemoon-site",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bluemoon",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F7F8FA",
    "ios": {
      "bundleIdentifier": "lk.bluemoonengineering.site",
      "supportsTablet": false
    },
    "android": {
      "package": "lk.bluemoonengineering.site",
      "versionCode": 1,
      "allowBackup": true,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-localization",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Bluemoon Site uses the camera to photograph bills, receipts, tools and site work.",
          "photosPermission": "Bluemoon Site lets you attach bill and site photos from your gallery."
        }
      ],
      [
        "expo-sharing",
        {
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "application/pdf",
              "application/zip"
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1120",
          "image": "./assets/images/splash-logo-white.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#0B1120",
            "image": "./assets/images/splash-logo-white.png"
          }
        }
      ],
      "expo-background-task",
      "./plugins/withBackupRules",
      "./plugins/withDialogTheme",
      "expo-status-bar",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
