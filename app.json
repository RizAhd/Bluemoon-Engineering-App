{
  "expo": {
    "name": "Bluemoon Site",
    "slug": "bluemoon-site",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bluemoon",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F8FAFC",
    "ios": {
      "bundleIdentifier": "lk.bluemoonengineering.site",
      "supportsTablet": false
    },
    "android": {
      "package": "lk.bluemoonengineering.site",
      "versionCode": 1,
      "allowBackup": true,
      "adaptiveIcon": {
        "backgroundColor": "#1D4ED8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-localization",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Bluemoon Site uses the camera to photograph bills, receipts, tools and site work.",
          "photosPermission": "Bluemoon Site lets you attach bill and site photos from your gallery."
        }
      ],
      [
        "expo-sharing",
        {
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "application/pdf",
              "application/zip"
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1D4ED8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-background-task",
      "./plugins/withBackupRules"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
